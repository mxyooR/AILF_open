# Run python scripts/setup_env.py to create .env with unique local secrets.
# These fields are deliberately empty. Never commit the generated .env.
JWT_SECRET_KEY=
DEVELOPER_PASSWORD=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

DEBUG=false
HOST=0.0.0.0
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=ailf
DB_NAME=ailf_db
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SEED_DEMO_USERS=false

# Limits apply to command orchestration in each backend process, including queue wait.
AI_COMMAND_MAX_CONCURRENT=2
AI_COMMAND_MAX_PENDING=64
AI_COMMAND_TIMEOUT_SECONDS=540
AI_COMMAND_CACHE_SIZE=1024
REDIS_AI_TASK_TTL=3600

# Full inference requires downloaded model weights. Paths are relative to the repo.
LOCAL_MODEL_BASE_PATH=Qwen/Qwen3-4B
LOCAL_MODEL_LORA_PATH=Model/checkpoint_epoch_2
EMBEDDING_MODEL_PATH=Model/bge-small-zh-v1.5
