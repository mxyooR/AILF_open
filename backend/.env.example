# AILF Backend 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ============================================
# 应用基础配置
# ============================================
DEBUG=true
HOST=0.0.0.0
PORT=5000

# ============================================
# JWT 认证配置
# ============================================
# 重要：生产环境必须修改为强密钥！
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_HOURS=24

# ============================================
# 开发者认证配置
# ============================================
# 重要：生产环境必须修改为强密码！
DEVELOPER_PASSWORD=your-strong-password-here

# ============================================
# 应用界面配置
# ============================================
APP_TITLE=AILF
APP_SUBTITLE=开发者配置面板

# ============================================
# 用户注册配置
# ============================================
DEFAULT_REGISTER_ROLE_CODE=regular_user
ALLOW_PUBLIC_REGISTRATION=true

# ============================================
# 配置完成状态
# ============================================
CONFIGURATION_COMPLETED=false

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
# 日志目录（留空则使用默认 backend/logs）
LOG_DIR=
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

# ============================================
# 数据库配置
# ============================================
# 重要：生产环境必须修改数据库密码！
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password-here
DB_NAME=ailf_db

# ============================================
# Redis 配置（工作流会话存储）
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=86400

# ============================================
# Celery 配置（AI 异步推理）
# ============================================
# Broker/结果后端建议使用与后端共享的 Redis
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_RESULT_EXPIRES=3600

# AI 推理队列
CELERY_AI_QUEUE=ai_inference
# 运行监控：完整推理任务（两轮合并）耗时统计
CELERY_INFERENCE_METRICS_KEY=ai:inference:metrics:full
CELERY_INFERENCE_METRICS_AGG_KEY=ai:inference:metrics:aggregate
CELERY_INFERENCE_METRICS_SAMPLE_SIZE=24
# 预期推理机（可选，逗号分隔）。配置后可在开发者配置看到离线节点。
# 示例: inference@GPU-01,inference@GPU-02
CELERY_EXPECTED_WORKERS=

# ============================================
# 图裁剪配置
# ============================================
EGO_GRAPH_TOP_K_API=15
EGO_GRAPH_TOP_K_WORKFLOW=5

# ============================================
# LLM 生成参数（用于后端编排阶段传参）
# ============================================
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_NEW_TOKENS=4096
