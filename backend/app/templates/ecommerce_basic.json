  "workflows": [
    {
      "name": "order_process_flow",
      "description": "从下单到完成的完整流程",
      "business_scenario": "ecommerce_basic",
      "status": "ACTIVE",
      "user_intents": [
        "处理订单",
        "订单管理",
        "订单流程"
      ],
      "trigger_keywords": [
        "订单",
        "下单",
        "支付",
        "发货"
      ],
      "inputs": {
        "order_id": {
          "type": "string",
          "required": true,
          "description": "订单ID"
        }
      },
      "nodes": [
        {
          "id": "start",
          "name": "开始",
          "type": "start",
          "position": {
            "x": 100,
            "y": 100
          }
        },
        {
          "id": "confirm_order",
          "name": "订单确认",
          "type": "api_call",
          "description": "确认订单信息和库存",
          "position": {
            "x": 300,
            "y": 100
          },
          "config": {
            "api_endpoint": "/api/v1/orders/confirm",
            "method": "POST",
            "parameters": {
              "order_id": "${order_id}",
              "confirm": "${confirm}"
            }
          }
        },
        {
          "id": "process_payment",
          "name": "支付处理",
          "type": "api_call",
          "description": "处理支付流程",
          "position": {
            "x": 500,
            "y": 100
          },
        "config": {
          "api_endpoint": "/api/v1/payments/process",
            "method": "POST"
          }
        },
        {
          "id": "end",
          "name": "结束",
          "type": "end",
          "position": {
            "x": 700,
            "y": 100
          }
        }
      ],
      "workflow_metadata": {
        "version": "1.0",
        "author": "AILF System",
        "tags": [
          "订单",
          "电商",
          "支付"
        ]
      }
    }
