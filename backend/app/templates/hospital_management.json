  "workflows": [
    {
      "name": "patient_visit_flow",
      "description": "从预约到就诊完成的完整流程",
      "business_scenario": "hospital_management",
      "status": "ACTIVE",
      "user_intents": [
        "患者就诊",
        "预约挂号",
        "医生诊疗"
      ],
      "trigger_keywords": [
        "就诊",
        "预约",
        "挂号",
        "看病"
      ],
      "inputs": {
        "patient_id": {
          "type": "string",
          "required": true,
          "description": "患者ID"
        },
        "appointment_id": {
          "type": "string",
          "required": false,
          "description": "预约ID"
        }
      },
      "nodes": [
        {
          "id": "start",
          "name": "开始",
          "type": "start",
          "description": "工作流开始节点",
          "position": {
            "x": 100,
            "y": 100
          },
          "parent_nodes": [],
          "child_nodes": [
            {
              "node_id": "register_patient",
              "condition": {
                "type": "always",
                "description": "总是执行"
              }
            }
          ],
          "config": {},
          "outputs": [],
          "ai_instructions": {
            "purpose": "开始患者就诊流程",
            "action": "初始化流程并收集患者信息"
          }
        },
        {
          "id": "register_patient",
          "name": "患者登记",
          "type": "api_call",
          "description": "登记患者基本信息",
          "position": {
            "x": 300,
            "y": 100
          },
          "parent_nodes": [
            "start"
          ],
          "child_nodes": [
            {
              "node_id": "create_appointment",
              "condition": {
                "type": "form_completed",
                "description": "患者信息登记完成"
              }
            }
          ],
          "config": {
            "api_endpoint": "/api/v1/patients/register",
            "method": "POST",
            "parameters": {
              "name": "${name}",
              "id_card": "${id_card}",
              "phone": "${phone}",
              "gender": "${gender}",
              "birth_date": "${birth_date}",
              "address": "${address}"
            }
          },
          "outputs": [
            {
              "name": "patient_info",
              "type": "object",
              "description": "患者基本信息"
            }
          ],
          "ai_instructions": {
            "purpose": "收集和验证患者基本信息",
            "action": "协助护士完成患者登记表单填写",
            "user_message": "请填写患者的基本信息，包括姓名、身份证号、联系电话等",
            "success_handling": "患者信息已成功登记，进入预约流程",
            "error_handling": "请检查填写信息是否完整和准确"
          }
        },
        {
          "id": "create_appointment",
          "name": "创建预约",
          "type": "api_call",
          "description": "创建或确认预约",
          "position": {
            "x": 500,
            "y": 100
          },
          "parent_nodes": [
            "register_patient"
          ],
          "child_nodes": [
            {
              "node_id": "doctor_examination",
              "condition": {
                "type": "expression",
                "expression": "appointment.status == '已预约'",
                "description": "预约创建成功"
              }
            }
          ],
          "config": {
            "api_endpoint": "/api/v1/appointments",
            "method": "POST",
            "parameters": {
              "appointment_no": "{{generate_appointment_no()}}",
              "patient_name": "{{patient_info.name}}",
              "doctor_name": "{{selected_doctor}}",
              "department": "{{selected_department}}",
              "appointment_date": "{{appointment_date}}",
              "appointment_time": "{{appointment_time}}"
            }
          },
          "outputs": [
            {
              "name": "appointment",
              "type": "object",
              "description": "预约信息"
            }
          ],
          "ai_instructions": {
            "purpose": "创建或确认患者的就诊预约",
            "action": "调用预约API创建预约记录",
            "user_message": "正在为您安排预约...",
            "success_handling": "预约创建成功，预约号：{{appointment.appointment_no}}",
            "error_handling": "预约创建失败，请重新选择时间或医生"
          }
        },
        {
          "id": "doctor_examination",
          "name": "医生诊疗",
          "type": "api_call",
          "description": "医生进行诊疗",
          "position": {
            "x": 700,
            "y": 100
          },
          "parent_nodes": [
            "create_appointment"
          ],
          "child_nodes": [
            {
              "node_id": "end",
              "condition": {
                "type": "form_completed",
                "description": "诊疗完成"
              }
            }
          ],
          "config": {
            "api_endpoint": "/api/v1/examinations",
            "method": "POST",
            "parameters": {
              "patient_id": "${patient_info.patient_id}",
              "symptoms": "${symptoms}",
              "diagnosis": "${diagnosis}",
              "treatment_plan": "${treatment_plan}",
              "prescription": "${prescription}"
            }
          },
          "outputs": [
            {
              "name": "diagnosis_result",
              "type": "object",
              "description": "诊疗结果"
            }
          ],
          "ai_instructions": {
            "purpose": "协助医生完成患者诊疗",
            "action": "提供诊疗表单和患者历史信息",
            "user_message": "请完成患者的诊疗记录",
            "success_handling": "诊疗完成，已生成病历记录",
            "error_handling": "请完善诊疗信息后再提交"
          }
        },
        {
          "id": "end",
          "name": "结束",
          "type": "end",
          "description": "工作流结束节点",
          "position": {
            "x": 900,
            "y": 100
          },
          "parent_nodes": [
            "doctor_examination"
          ],
          "child_nodes": [],
          "config": {},
          "outputs": [
            {
              "name": "final_result",
              "type": "object",
              "description": "就诊流程完成结果"
            }
          ],
          "ai_instructions": {
            "purpose": "完成患者就诊流程",
            "action": "整理并归档就诊记录",
            "user_message": "就诊流程已完成，感谢您的配合",
            "success_handling": "患者就诊流程已成功完成",
            "error_handling": "流程完成时遇到问题，请联系管理员"
          }
        }
      ],
      "workflow_metadata": {
        "version": "1.0",
        "author": "AILF System",
        "tags": [
          "医院",
          "就诊",
          "预约"
        ],
        "complexity": "medium"
      }
    }
  ]
