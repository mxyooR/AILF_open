  "api_routes": [
    {
      "api_id": "patient_create_api",
      "name": "患者创建API",
      "endpoint": "/api/v1/patients",
      "method": "POST",
      "description": "创建新的患者记录，包含基本信息和联系方式",
      "auth_required": true,
      "handler": {
        "type": "entity_crud",
        "config": {
          "entity": "patient",
          "operation": "create",
          "allowed_fields": [
            "name",
            "id_card",
            "phone",
            "gender",
            "birth_date",
            "address"
          ],
          "validation_rules": {
            "name": "required|max:50",
            "id_card": "required|unique:patients,id_card|regex:^[1-9]\\d{5}(18|19|20)\\d{2}((0[1-9])|(1[0-2]))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$",
            "phone": "required|regex:^1[3-9]\\d{9}$",
            "gender": "required|in:男,女",
            "birth_date": "required|date"
          },
          "auto_timestamps": true
        }
      },
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "患者姓名",
          "validation": {
            "max_length": 50,
            "min_length": 2
          }
        },
        {
          "name": "id_card",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "身份证号码",
          "validation": {
            "pattern": "^[1-9]\\d{5}(18|19|20)\\d{2}((0[1-9])|(1[0-2]))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$"
          }
        },
        {
          "name": "phone",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "联系电话",
          "validation": {
            "pattern": "^1[3-9]\\d{9}$"
          }
        },
        {
          "name": "gender",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "性别",
          "validation": {
            "enum": [
              "男",
              "女"
            ]
          }
        },
        {
          "name": "birth_date",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "出生日期",
          "validation": {
            "format": "date"
          }
        },
        {
          "name": "address",
          "type": "string",
          "location": "body",
          "required": false,
          "description": "联系地址",
          "validation": {
            "max_length": 200
          }
        }
      ],
      "responses": {
        "201": {
          "description": "患者创建成功",
          "response_schema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "example": 201
              },
              "message": {
                "type": "string",
                "example": "患者创建成功"
              },
              "data": {
                "type": "object",
                "properties": {
                  "patient": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "id_card": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      },
                      "gender": {
                        "type": "string"
                      },
                      "birth_date": {
                        "type": "string",
                        "format": "date"
                      },
                      "address": {
                        "type": "string"
                      },
                      "created_at": {
                        "type": "string",
                        "format": "datetime"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "请求参数验证失败",
          "response_schema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "example": 400
              },
              "message": {
                "type": "string",
                "example": "参数验证失败"
              },
              "data": {
                "type": "object",
                "properties": {
                  "error_type": {
                    "type": "string"
                  },
                  "details": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      },
      "form_config": {
        "auto_generate": true,
        "layout": {
          "type": "grid",
          "columns": 2,
          "spacing": 16
        },
        "sections": [
          {
            "title": "基本信息",
            "fields": [
              "name",
              "id_card",
              "gender",
              "birth_date"
            ]
          },
          {
            "title": "联系信息",
            "fields": [
              "phone",
              "address"
            ]
          }
        ]
      }
    },
    {
      "api_id": "patient_list_api",
      "name": "患者列表API",
      "endpoint": "/api/v1/patients",
      "method": "GET",
      "description": "获取患者列表，支持分页和筛选",
      "auth_required": true,
      "handler": {
        "type": "entity_crud",
        "config": {
          "entity": "patient",
          "operation": "list",
          "allowed_fields": [
            "name",
            "id_card",
            "phone",
            "gender",
            "birth_date",
            "address"
          ],
          "default_page_size": 20,
          "max_page_size": 100,
          "searchable_fields": [
            "name",
            "phone",
            "id_card"
          ],
          "sortable_fields": [
            "name",
            "birth_date",
            "created_at"
          ]
        }
      },
      "parameters": [
        {
          "name": "page",
          "type": "integer",
          "location": "query",
          "required": false,
          "description": "页码，默认1",
          "validation": {
            "min": 1
          }
        },
        {
          "name": "limit",
          "type": "integer",
          "location": "query",
          "required": false,
          "description": "每页数量，默认20，最大100",
          "validation": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "search",
          "type": "string",
          "location": "query",
          "required": false,
          "description": "搜索关键词（姓名、电话、身份证）"
        },
        {
          "name": "gender",
          "type": "string",
          "location": "query",
          "required": false,
          "description": "性别筛选",
          "validation": {
            "enum": [
              "男",
              "女"
            ]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "获取患者列表成功",
          "response_schema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "example": 200
              },
              "message": {
                "type": "string",
                "example": "获取患者列表成功"
              },
              "data": {
                "type": "object",
                "properties": {
                  "patients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "phone": {
                          "type": "string"
                        },
                        "gender": {
                          "type": "string"
                        },
                        "birth_date": {
                          "type": "string",
                          "format": "date"
                        }
                      }
                    }
                  },
                  "pagination": {
                    "type": "object",
                    "properties": {
                      "page": {
                        "type": "integer"
                      },
                      "limit": {
                        "type": "integer"
                      },
                      "total": {
                        "type": "integer"
                      },
                      "pages": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
