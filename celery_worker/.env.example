# ============================================
# Celery Worker 环境变量示例
# ============================================

# Broker / Result Backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_RESULT_EXPIRES=3600
CELERY_AI_QUEUE=ai_inference

# Worker 任务执行参数
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=180
CELERY_TASK_TIME_LIMIT=240
CELERY_BROKER_VISIBILITY_TIMEOUT=3600
CELERY_INFERENCE_METRICS_ENABLED=true
CELERY_INFERENCE_METRICS_KEY=ai:inference:metrics:full
CELERY_INFERENCE_METRICS_AGG_KEY=ai:inference:metrics:aggregate
CELERY_INFERENCE_METRICS_MAX_SAMPLES=240

# Worker 启动参数（start_celery_worker.ps1 读取）
CELERY_WORKER_POOL=solo
CELERY_WORKER_LOGLEVEL=info
CELERY_WORKER_CONCURRENCY=1

# 模型加载与推理
MODEL_PRELOAD_ON_WORKER_START=true
MODEL_LOAD_ON_CELERY_TASK=true
LOCAL_MODEL_BASE_PATH=Qwen/Qwen3-4B
LOCAL_MODEL_LORA_PATH=Model/checkpoint_epoch_2
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_NEW_TOKENS=4096

# Embedding（图裁剪）
EMBEDDING_MODEL_PATH=Model/bge-small-zh-v1.5
EMBEDDING_DEVICE=cuda:0
EMBEDDING_USE_API=false
EGO_GRAPH_TOP_K_API=15
EGO_GRAPH_TOP_K_WORKFLOW=5
EGO_GRAPH_TOP_K=15
EGO_GRAPH_HOP=1
