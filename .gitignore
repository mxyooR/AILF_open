*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.bin
!Model/bge-small-zh-v1.5/pytorch_model.bin.example

# (datasets are tracked in Git)

# Legacy competition code (not part of open source)
Model/old/

# Exclude optimizer states (not needed for inference)
**/training_state.pt

# Exclude original base model directories
Qwen/
Qwen3-8B/

# Cache
*.cache
.cache/

