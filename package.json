{
  "name": "ailf",
  "version": "2.0.0",
  "description": "AILF — Turn natural language into permission-aware business interfaces",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir frontend start",
    "dev:frontend": "pnpm --dir frontend start",
    "dev:backend": "python backend/main.py",
    "build": "pnpm --dir frontend build",
    "build:frontend": "pnpm --dir frontend build",
    "test": "pnpm --dir frontend test --watchAll=false --runInBand",
    "typecheck": "pnpm --dir frontend exec tsc --noEmit",
    "lint": "pnpm --dir frontend exec eslint src --ext .ts,.tsx,.js",
    "check:public": "python scripts/check_public_repo.py",
    "start": "pnpm dev"
  },
  "keywords": [
    "generative-ui",
    "workflow",
    "react",
    "fastapi",
    "amis",
    "qwen",
    "lora"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxyooR/AILF_open.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "react-pdf": "9.0.0"
    }
  }
}
