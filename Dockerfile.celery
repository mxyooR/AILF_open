FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY celery_worker/requirements.txt ./celery_worker/requirements.txt
RUN pip install --no-cache-dir -r celery_worker/requirements.txt
COPY celery_worker/ ./celery_worker/
# Model weights are mounted read-only at runtime, never baked into the image.
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
CMD ["celery", "-A", "celery_worker.celery_app:celery_app", "worker", "--loglevel=info", "--pool=solo", "--concurrency=1", "-Q", "ai_inference"]
